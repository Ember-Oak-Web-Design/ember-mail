---
// Minimal, self-contained layout for legal pages. Swap for your site's own layout if you prefer,
// but keep the robots meta tag: these pages are public (Google must be able to open them) yet unlisted.
interface Props { title: string; updated: string }
const { title, updated } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Ember Mail</title>
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="canonical" href={Astro.url.href} />
    <style>
      :root { color-scheme: light dark; --bg:#faf7f5; --fg:#2b1d14; --muted:#7a6a5e; --accent:#d9531f; --line:#e8dfd8; }
      @media (prefers-color-scheme: dark) { :root { --bg:#17100b; --fg:#f3e9e1; --muted:#b3a498; --line:#33261d; } }
      body { margin:0; background:var(--bg); color:var(--fg); font:17px/1.65 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
      main { max-width: 720px; margin: 0 auto; padding: 56px 20px 96px; }
      h1 { font-size: 2rem; line-height: 1.2; margin: 0 0 4px; }
      h2 { font-size: 1.2rem; margin: 2.2em 0 .4em; padding-top: 1.2em; border-top: 1px solid var(--line); }
      p, li { margin: .6em 0; }
      .meta { color: var(--muted); font-size: .9rem; margin-bottom: 2rem; }
      a { color: var(--accent); }
      .brand { font-weight: 700; letter-spacing: .02em; color: var(--accent); margin-bottom: 28px; }
    </style>
  </head>
  <body>
    <main>
      <div class="brand">Ember &amp; Oak · Ember Mail</div>
      <h1>{title}</h1>
      <div class="meta">Last updated {updated}</div>
      <slot />
    </main>
  </body>
</html>
